# Vite automatically uses this file (instead of .env) when you run
# `npm run build`. Leaving VITE_API_BASE_URL empty means the dashboard
# calls relative paths like "/v1/usage" instead of a full URL - nginx
# then routes those to the backend container internally. No CORS needed
# in production because the browser only ever talks to one origin.
VITE_API_BASE_URL=
VITE_GATEWAY_API_KEY=dev-key-123
