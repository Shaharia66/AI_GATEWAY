# Real provider keys - the gateway uses these to actually call OpenAI/Groq.
# Get OpenAI key: https://platform.openai.com/api-keys
# Get Groq key (free tier): https://console.groq.com/keys
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=gsk-your-groq-key-here
GOOGLE_API_KEY=your-real-key
CEREBRAS_API_KEY=your-real-cerebras-key
MISTRAL_API_KEY=your-real-mistral-key

# Keys YOU issue to people/apps allowed to use YOUR gateway.
# Make up any strings you like, comma separated, no spaces around commas.
GATEWAY_API_KEYS=dev-key-123,test-key-456
